; SEGMENTS_METADATA: [{"tipo": "hook", "texto": "\u00bfBandeja de entrada llena de mensajes repetitivos que te roban la energ\u00eda?", "inicio": 0.0, "fin": 4.615}, {"tipo": "punto_1", "texto": "Shortwave. Redacta borradores autom\u00e1ticos y res\u00famenes de tus correos usando inteligencia artificial. Me encanta c\u00f3mo clava un tono natural sin sonar como un robot fr\u00edo.", "inicio": 4.615, "fin": 15.923}, {"tipo": "punto_2", "texto": "SaneBox. Filtra tus correos importantes y env\u00eda boletines o distracciones a carpetas secundarias. Al principio conviene revisar qu\u00e9 filtra, pero despu\u00e9s te limpia todo el caos.", "inicio": 15.923, "fin": 27.963}, {"tipo": "cierre", "texto": "Coment\u00e1 abajo cu\u00e1ntos correos sin leer acumul\u00e1s hoy.", "inicio": 27.963, "fin": 31.579}]

